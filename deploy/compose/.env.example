# Copy outside checkout to a private file (chmod 600); never commit secrets.
# Generate hex credentials with openssl rand -hex 32 (URI-safe for the DSN).
POSTGRES_PASSWORD=
INSTANT_V2_STORAGE_SECRET=
# Set after signature/provenance verification; includes the sha256: prefix.
INSTANT_V2_IMAGE_DIGEST=
# Authorization-code startup settings; provider flows require real OAuth apps.
INSTANT_OAUTH_GOOGLE_CLIENT_ID=
INSTANT_OAUTH_GOOGLE_CLIENT_SECRET=
INSTANT_OAUTH_GITHUB_CLIENT_ID=
INSTANT_OAUTH_GITHUB_CLIENT_SECRET=
