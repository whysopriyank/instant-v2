# syntax=docker/dockerfile:1
# Existing protocol smoke tools; the candidate remains a separate image.
FROM golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /soaksetup ./cmd/soaksetup \
    && CGO_ENABLED=0 go build -o /soak ./cmd/soak
FROM scratch
COPY --from=build /soaksetup /soaksetup
COPY --from=build /soak /soak
