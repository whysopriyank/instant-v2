{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instant-v2/bench-v1/live-config",
  "title": "instant-v2 live benchmark configuration",
  "type": "object",
  "required": ["pair_id", "seed", "family", "scale", "output", "fixture_path", "fixture_hash", "fixture", "targets"],
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "not": {"const": 0}},
    "family": {"type": "string", "minLength": 1},
    "scale": {"type": "integer", "minimum": 1},
    "output": {"type": "string", "minLength": 1},
    "ramp_seconds": {"type": "integer", "minimum": 0},
    "settle_seconds": {"type": "integer", "minimum": 0},
    "warmup_seconds": {"type": "integer", "minimum": 0},
    "warmup_mutations": {"type": "integer", "minimum": 0},
    "measure_seconds": {"type": "integer", "minimum": 0},
    "grace_seconds": {"type": "integer", "minimum": 0},
    "timeout_seconds": {"type": "integer", "minimum": 0},
    "v1_sha": {"type": "string"},
    "v2_sha": {"type": "string"},
    "v2_reference_sha": {"type": "string"},
    "source_tree": {"type": "string"},
    "schema_hash": {"type": "string"},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "fixture_path": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string"},
    "host_id": {"type": "string"},
    "executables": {"type": "object", "additionalProperties": {"type": "string"}},
    "approval_public_key": {"type": "string"},
    "approval_signature": {"type": "string"},
    "authorization_public_key": {"type": "string"},
    "authorization_signature": {"type": "string"},
    "fixture": {
      "type": "object",
      "required": ["id_attr", "id_attr_id", "value_attr_id", "bucket_attr_id", "rank_attr_id", "id_attr_value_type", "id_attr_value_encoding", "id_attr_cardinality", "id_attr_unique", "id_attr_indexed", "id_attr_required", "id_attr_primary", "id_attr_identity"],
      "properties": {
        "entity_type": {"type": "string", "minLength": 1},
        "id_attr": {"const": "id"},
        "value_attr": {"type": "string", "minLength": 1},
        "bucket_attr": {"type": "string"},
        "rank_attr": {"type": "string"},
        "query_entity": {"type": "string", "minLength": 1},
        "query_bucket_attr": {"type": "string"},
        "query_rank_attr": {"type": "string"},
        "id_attr_id": {"allOf": [{"$ref": "#/$defs/uuid"}, {"const": "00000000-0000-0000-0000-000000000100"}]},
        "id_attr_value_type": {"const": "blob"},
        "id_attr_value_encoding": {"const": "string"},
        "id_attr_cardinality": {"const": "one"},
        "id_attr_unique": {"const": true},
        "id_attr_indexed": {"const": true},
        "id_attr_required": {"const": true},
        "id_attr_primary": {"const": true},
        "id_attr_identity": {"const": true},
        "value_attr_id": {"allOf": [{"$ref": "#/$defs/uuid"}, {"const": "00000000-0000-0000-0000-000000000101"}]},
        "bucket_attr_id": {"allOf": [{"$ref": "#/$defs/uuid"}, {"const": "00000000-0000-0000-0000-000000000102"}]},
        "rank_attr_id": {"allOf": [{"$ref": "#/$defs/uuid"}, {"const": "00000000-0000-0000-0000-000000000103"}]}
      },
      "additionalProperties": false
    },
    "targets": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/target"}}
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "target": {
      "type": "object",
      "required": [
        "id", "kind", "transport", "session_url", "health_url", "app_id", "revision",
        "database_name", "postgres_version", "invalidation_mode", "metadata_file",
        "provisioned_marker", "provision_command", "provision_command_sha256",
        "database_url_env", "admin_token_env", "refresh_token_env", "runtime_token_env",
        "process_pid_env", "probe_entity_id", "process_executable_path", "process_executable_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "kind": {"enum": ["v1", "v2"]},
        "transport": {"enum": ["websocket", "sse"]},
        "session_url": {"type": "string", "minLength": 1},
        "health_url": {"type": "string", "minLength": 1},
        "admin_base_url": {"type": "string"},
        "app_id": {"$ref": "#/$defs/uuid"},
        "revision": {"type": "string", "minLength": 1},
        "dirty_tree_hash": {"type": "string"},
        "database_name": {"type": "string", "minLength": 1},
        "postgres_version": {"type": "string", "minLength": 1},
        "invalidation_mode": {"type": "string", "minLength": 1},
        "output_plugin": {"type": "string"},
        "admin_token_env": {"type": "string", "minLength": 1},
        "refresh_token_env": {"type": "string", "minLength": 1},
        "metadata_file": {"type": "string", "minLength": 1},
        "provisioned_marker": {"type": "string", "minLength": 1},
        "provision_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "provision_command_sha256": {"$ref": "#/$defs/sha256"},
        "database_url_env": {"type": "string", "minLength": 1},
        "probe_entity_id": {"$ref": "#/$defs/uuid"},
        "versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "process_pid_env": {"type": "string", "minLength": 1},
        "process_pid_file": {"type": "string"},
        "network_namespace_id": {"type": "string"},
        "initial_network_namespace_id": {"type": "string"},
        "process_executable_path": {"type": "string", "minLength": 1},
        "process_executable_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_endpoint": {"type": "string"},
        "runtime_token_env": {"type": "string", "minLength": 1},
        "collector_interval_millis": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
